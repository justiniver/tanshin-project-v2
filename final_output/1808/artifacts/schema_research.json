{
  "$defs": {
    "CommentaryIntensity": {
      "enum": [
        "low",
        "moderate",
        "high",
        "not_assessable"
      ],
      "title": "CommentaryIntensity",
      "type": "string"
    },
    "CommentaryTone": {
      "enum": [
        "positive",
        "negative",
        "mixed",
        "neutral",
        "uncertain"
      ],
      "title": "CommentaryTone",
      "type": "string"
    },
    "CommitmentOutcome": {
      "enum": [
        "achieved",
        "exceeded",
        "partly_achieved",
        "missed",
        "delayed",
        "revised",
        "withdrawn",
        "pending",
        "not_observable"
      ],
      "title": "CommitmentOutcome",
      "type": "string"
    },
    "CommitmentType": {
      "enum": [
        "annual_forecast",
        "medium_term_target",
        "strategic_commitment",
        "capital_allocation"
      ],
      "title": "CommitmentType",
      "type": "string"
    },
    "CompanyIdentity": {
      "additionalProperties": false,
      "properties": {
        "security_code": {
          "description": "Exact requested security code; do not infer a different issuer.",
          "minLength": 1,
          "title": "Security Code",
          "type": "string"
        },
        "company_name_ja": {
          "description": "Japanese company name stated in the latest supplied filing.",
          "minLength": 1,
          "title": "Company Name Ja",
          "type": "string"
        },
        "company_name_en": {
          "description": "English company name stated in the supplied filings, or a faithful romanization when no English name is shown.",
          "minLength": 1,
          "title": "Company Name En",
          "type": "string"
        },
        "latest_filename": {
          "description": "Exact authoritative filename of the filing identified as latest.",
          "minLength": 1,
          "title": "Latest Filename",
          "type": "string"
        },
        "latest_period_ja": {
          "description": "Concise Japanese reporting-period label for the latest filing.",
          "minLength": 1,
          "title": "Latest Period Ja",
          "type": "string"
        },
        "latest_period_en": {
          "description": "Concise English equivalent of latest_period_ja.",
          "minLength": 1,
          "title": "Latest Period En",
          "type": "string"
        }
      },
      "required": [
        "security_code",
        "company_name_ja",
        "company_name_en",
        "latest_filename",
        "latest_period_ja",
        "latest_period_en"
      ],
      "title": "CompanyIdentity",
      "type": "object"
    },
    "DisclosureCategory": {
      "enum": [
        "impairment",
        "unusual_gain_or_loss",
        "litigation_or_regulatory",
        "accounting_or_estimate_change",
        "going_concern",
        "related_party",
        "capital_allocation",
        "risk",
        "other"
      ],
      "title": "DisclosureCategory",
      "type": "string"
    },
    "DiscussionCoverageStatus": {
      "enum": [
        "extracted",
        "not_material",
        "not_available"
      ],
      "title": "DiscussionCoverageStatus",
      "type": "string"
    },
    "FilingCoverageStatus": {
      "enum": [
        "complete",
        "partial",
        "no_material_disclosure"
      ],
      "title": "FilingCoverageStatus",
      "type": "string"
    },
    "FilingPeriod": {
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "FY",
        "UNKNOWN"
      ],
      "title": "FilingPeriod",
      "type": "string"
    },
    "FinancialMetric": {
      "enum": [
        "revenue",
        "operating_profit",
        "ordinary_profit",
        "pretax_profit",
        "net_income",
        "operating_cash_flow",
        "investing_cash_flow",
        "free_cash_flow",
        "total_assets",
        "net_assets",
        "interest_bearing_debt",
        "dividend_per_share",
        "segment_revenue",
        "segment_profit",
        "other"
      ],
      "title": "FinancialMetric",
      "type": "string"
    },
    "FinancialScope": {
      "enum": [
        "consolidated",
        "company_only",
        "segment",
        "other"
      ],
      "title": "FinancialScope",
      "type": "string"
    },
    "FinancialValueKind": {
      "enum": [
        "monetary",
        "percentage",
        "per_share",
        "count",
        "ratio",
        "other"
      ],
      "title": "FinancialValueKind",
      "type": "string"
    },
    "ForecastPosture": {
      "enum": [
        "conservative",
        "balanced",
        "aggressive",
        "mixed",
        "not_assessable"
      ],
      "title": "ForecastPosture",
      "type": "string"
    },
    "ForecastVersion": {
      "enum": [
        "original",
        "revised",
        "latest",
        "not_applicable"
      ],
      "title": "ForecastVersion",
      "type": "string"
    },
    "ResearchAnnualFinancialAnchor": {
      "description": "One year-end actual paired with the next original annual forecast.",
      "properties": {
        "anchor_id": {
          "minLength": 1,
          "title": "Anchor Id",
          "type": "string"
        },
        "source_filename": {
          "minLength": 1,
          "title": "Source Filename",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/FinancialMetric"
        },
        "metric_label_ja": {
          "minLength": 1,
          "title": "Metric Label Ja",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/FinancialScope"
        },
        "scope_label_ja": {
          "minLength": 1,
          "title": "Scope Label Ja",
          "type": "string"
        },
        "value_kind": {
          "$ref": "#/$defs/FinancialValueKind"
        },
        "actual": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchAnnualFinancialPoint"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current year-end actual for the selected anchor metric, or null when the filing does not disclose a usable value."
        },
        "next_original_forecast": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchAnnualFinancialPoint"
            },
            {
              "type": "null"
            }
          ],
          "description": "The first disclosed next-year annual forecast for the same metric and scope, or null when unavailable."
        }
      },
      "required": [
        "anchor_id",
        "source_filename",
        "metric",
        "metric_label_ja",
        "scope",
        "scope_label_ja",
        "value_kind",
        "actual",
        "next_original_forecast"
      ],
      "title": "ResearchAnnualFinancialAnchor",
      "type": "object"
    },
    "ResearchAnnualFinancialPoint": {
      "description": "One actual or original-forecast value inside a compact annual anchor.",
      "properties": {
        "target_fiscal_year": {
          "maximum": 2200,
          "minimum": 1900,
          "title": "Target Fiscal Year",
          "type": "integer"
        },
        "target_period": {
          "$ref": "#/$defs/FilingPeriod"
        },
        "value_surface_ja": {
          "description": "Exact monetary, percentage, per-share, count, or ratio surface.",
          "minLength": 1,
          "title": "Value Surface Ja",
          "type": "string"
        },
        "source_record_id": {
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        }
      },
      "required": [
        "target_fiscal_year",
        "target_period",
        "value_surface_ja",
        "source_record_id"
      ],
      "title": "ResearchAnnualFinancialPoint",
      "type": "object"
    },
    "ResearchCommentaryObservation": {
      "description": "One filing-specific management-commentary observation.",
      "properties": {
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "source_filename": {
          "minLength": 1,
          "title": "Source Filename",
          "type": "string"
        },
        "fiscal_year": {
          "maximum": 2200,
          "minimum": 1900,
          "title": "Fiscal Year",
          "type": "integer"
        },
        "period_label_ja": {
          "minLength": 1,
          "title": "Period Label Ja",
          "type": "string"
        },
        "canonical_tag": {
          "description": "Stable reusable comparison-track category such as demand, volume, pricing, material_costs, labor_costs, foreign_exchange, interest_rates, capital_allocation, or overseas_execution. Use the same tag only for genuinely comparable wording across filings; omit isolated boilerplate instead of assigning a miscellaneous tag.",
          "minLength": 1,
          "title": "Canonical Tag",
          "type": "string"
        },
        "label_ja": {
          "minLength": 1,
          "title": "Label Ja",
          "type": "string"
        },
        "tone": {
          "$ref": "#/$defs/CommentaryTone"
        },
        "intensity": {
          "$ref": "#/$defs/CommentaryIntensity"
        },
        "summary_ja": {
          "minLength": 1,
          "title": "Summary Ja",
          "type": "string"
        },
        "source_record_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Record Ids",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "source_filename",
        "fiscal_year",
        "period_label_ja",
        "canonical_tag",
        "label_ja",
        "tone",
        "intensity",
        "summary_ja",
        "source_record_ids"
      ],
      "title": "ResearchCommentaryObservation",
      "type": "object"
    },
    "ResearchCommitmentRecord": {
      "description": "A material commitment connected to a later observable outcome.",
      "properties": {
        "commitment_id": {
          "minLength": 1,
          "title": "Commitment Id",
          "type": "string"
        },
        "source_filename": {
          "minLength": 1,
          "title": "Source Filename",
          "type": "string"
        },
        "fiscal_year": {
          "maximum": 2200,
          "minimum": 1900,
          "title": "Fiscal Year",
          "type": "integer"
        },
        "period_label_ja": {
          "minLength": 1,
          "title": "Period Label Ja",
          "type": "string"
        },
        "commitment_type": {
          "$ref": "#/$defs/CommitmentType"
        },
        "statement_period_ja": {
          "minLength": 1,
          "title": "Statement Period Ja",
          "type": "string"
        },
        "commitment_ja": {
          "minLength": 1,
          "title": "Commitment Ja",
          "type": "string"
        },
        "due_period_ja": {
          "minLength": 1,
          "title": "Due Period Ja",
          "type": "string"
        },
        "outcome_status": {
          "$ref": "#/$defs/CommitmentOutcome"
        },
        "outcome_ja": {
          "description": "Later result or a concise statement that the outcome is not yet observable in the selected filings.",
          "minLength": 1,
          "title": "Outcome Ja",
          "type": "string"
        },
        "revision_direction": {
          "$ref": "#/$defs/RevisionDirection"
        },
        "forecast_posture": {
          "$ref": "#/$defs/ForecastPosture"
        },
        "source_record_ids": {
          "description": "Source records for the original statement and, when explicitly disclosed, its revision or later outcome. Do not duplicate an ordinary annual numeric forecast already represented by paired financial observations.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Record Ids",
          "type": "array"
        }
      },
      "required": [
        "commitment_id",
        "source_filename",
        "fiscal_year",
        "period_label_ja",
        "commitment_type",
        "statement_period_ja",
        "commitment_ja",
        "due_period_ja",
        "outcome_status",
        "outcome_ja",
        "revision_direction",
        "forecast_posture",
        "source_record_ids"
      ],
      "title": "ResearchCommitmentRecord",
      "type": "object"
    },
    "ResearchDisclosureRecord": {
      "description": "Material footnote or mandatory-disclosure signal.",
      "properties": {
        "disclosure_id": {
          "minLength": 1,
          "title": "Disclosure Id",
          "type": "string"
        },
        "source_filename": {
          "minLength": 1,
          "title": "Source Filename",
          "type": "string"
        },
        "fiscal_year": {
          "maximum": 2200,
          "minimum": 1900,
          "title": "Fiscal Year",
          "type": "integer"
        },
        "category": {
          "$ref": "#/$defs/DisclosureCategory"
        },
        "label_ja": {
          "minLength": 1,
          "title": "Label Ja",
          "type": "string"
        },
        "summary_ja": {
          "minLength": 1,
          "title": "Summary Ja",
          "type": "string"
        },
        "importance": {
          "enum": [
            "primary",
            "secondary"
          ],
          "title": "Importance",
          "type": "string"
        },
        "source_record_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Record Ids",
          "type": "array"
        }
      },
      "required": [
        "disclosure_id",
        "source_filename",
        "fiscal_year",
        "category",
        "label_ja",
        "summary_ja",
        "importance",
        "source_record_ids"
      ],
      "title": "ResearchDisclosureRecord",
      "type": "object"
    },
    "ResearchDiscussionSection": {
      "description": "Explicit inspection result for one qualitative filing section.",
      "properties": {
        "status": {
          "$ref": "#/$defs/DiscussionCoverageStatus",
          "description": "Use extracted when useful management discussion was retained, not_material when the section was inspected but contained only routine or immaterial text, and not_available when the filing did not contain the section or it could not be read."
        },
        "source_record_ids": {
          "description": "Source records retained from this section. Keep empty only when status is not_material or not_available.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Record Ids",
          "type": "array"
        },
        "coverage_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Concise reason for not_material or not_available. Normally null when status is extracted.",
          "title": "Coverage Note"
        }
      },
      "required": [
        "status",
        "source_record_ids"
      ],
      "title": "ResearchDiscussionSection",
      "type": "object"
    },
    "ResearchFilingCoverage": {
      "description": "Coverage ledger proving that every selected filing was inspected.",
      "properties": {
        "source_filename": {
          "description": "Exact filename of one selected filing.",
          "minLength": 1,
          "title": "Source Filename",
          "type": "string"
        },
        "fiscal_year": {
          "maximum": 2200,
          "minimum": 1900,
          "title": "Fiscal Year",
          "type": "integer"
        },
        "period": {
          "$ref": "#/$defs/FilingPeriod"
        },
        "period_label_ja": {
          "minLength": 1,
          "title": "Period Label Ja",
          "type": "string"
        },
        "is_latest": {
          "title": "Is Latest",
          "type": "boolean"
        },
        "coverage_status": {
          "$ref": "#/$defs/FilingCoverageStatus"
        },
        "operating_results": {
          "$ref": "#/$defs/ResearchDiscussionSection",
          "description": "Coverage of 経営成績に関する説明 and management's explanation of the period's operating and earnings drivers."
        },
        "financial_condition": {
          "$ref": "#/$defs/ResearchDiscussionSection",
          "description": "Coverage of 財政状態に関する説明, cash flow, working capital, debt, liquidity, and other balance-sheet developments."
        },
        "forward_looking_information": {
          "$ref": "#/$defs/ResearchDiscussionSection",
          "description": "Coverage of 業績予想などの将来予測情報に関する説明, assumptions, risks, forecast revisions, and management's outlook."
        },
        "strategy_and_plan_progress": {
          "$ref": "#/$defs/ResearchDiscussionSection",
          "description": "Coverage of strategy, medium-term-plan progress, operational initiatives, and management's stated response to results."
        },
        "segment_and_business_conditions": {
          "$ref": "#/$defs/ResearchDiscussionSection",
          "description": "Coverage of segment, product, market, customer, geography, and business-specific conditions discussed by management."
        },
        "capital_allocation": {
          "$ref": "#/$defs/ResearchDiscussionSection",
          "description": "Coverage of dividends, investment, acquisitions, disposals, debt, cash deployment, and other capital-allocation discussion."
        },
        "material_footnotes": {
          "$ref": "#/$defs/ResearchDiscussionSection",
          "description": "Coverage of decision-useful mandatory disclosures and footnotes, excluding routine notes."
        },
        "annual_financial_anchor_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Annual Financial Anchor Ids",
          "type": "array"
        },
        "financial_observation_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Financial Observation Ids",
          "type": "array"
        },
        "commentary_observation_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Commentary Observation Ids",
          "type": "array"
        },
        "disclosure_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Disclosure Ids",
          "type": "array"
        },
        "commitment_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Commitment Ids",
          "type": "array"
        },
        "coverage_gaps": {
          "description": "Concise missing or unavailable categories. Use an empty list when coverage is complete; never silently omit an unavailable category.",
          "items": {
            "type": "string"
          },
          "title": "Coverage Gaps",
          "type": "array"
        }
      },
      "required": [
        "source_filename",
        "fiscal_year",
        "period",
        "period_label_ja",
        "is_latest",
        "coverage_status",
        "operating_results",
        "financial_condition",
        "forward_looking_information",
        "strategy_and_plan_progress",
        "segment_and_business_conditions",
        "capital_allocation",
        "material_footnotes",
        "annual_financial_anchor_ids",
        "financial_observation_ids",
        "commentary_observation_ids",
        "disclosure_ids",
        "commitment_ids",
        "coverage_gaps"
      ],
      "title": "ResearchFilingCoverage",
      "type": "object"
    },
    "ResearchFinancialObservation": {
      "description": "A useful financial value outside the compact annual anchor series.",
      "properties": {
        "observation_id": {
          "description": "Stable unique observation ID for a latest-period, revised-guidance, cash-flow, balance-sheet, dividend, segment, or other supplemental value not already represented in annual_financial_anchors.",
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "source_filename": {
          "minLength": 1,
          "title": "Source Filename",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/FinancialMetric"
        },
        "metric_label_ja": {
          "minLength": 1,
          "title": "Metric Label Ja",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/FinancialScope"
        },
        "scope_label_ja": {
          "minLength": 1,
          "title": "Scope Label Ja",
          "type": "string"
        },
        "value_kind": {
          "$ref": "#/$defs/FinancialValueKind"
        },
        "statement_type": {
          "enum": [
            "actual",
            "forecast",
            "target"
          ],
          "title": "Statement Type",
          "type": "string"
        },
        "forecast_version": {
          "$ref": "#/$defs/ForecastVersion",
          "description": "Use original for the first disclosed annual forecast, revised only for an explicit later revision, latest only when the source gives a current forecast without establishing whether it is original, and not_applicable for actuals or targets."
        },
        "target_fiscal_year": {
          "maximum": 2200,
          "minimum": 1900,
          "title": "Target Fiscal Year",
          "type": "integer"
        },
        "target_period": {
          "$ref": "#/$defs/FilingPeriod"
        },
        "value_surface_ja": {
          "description": "Monetary, percentage, per-share, count, or ratio surface as written in the filing.",
          "minLength": 1,
          "title": "Value Surface Ja",
          "type": "string"
        },
        "source_record_id": {
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "source_filename",
        "metric",
        "metric_label_ja",
        "scope",
        "scope_label_ja",
        "value_kind",
        "statement_type",
        "forecast_version",
        "target_fiscal_year",
        "target_period",
        "value_surface_ja",
        "source_record_id"
      ],
      "title": "ResearchFinancialObservation",
      "type": "object"
    },
    "ResearchSourceRecord": {
      "description": "Lightweight provenance attached to extracted filing information.",
      "properties": {
        "record_id": {
          "description": "Stable unique source-record ID used only to connect synthesis conclusions to extracted filing information.",
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "source_filename": {
          "description": "Exact filename of the selected filing.",
          "minLength": 1,
          "title": "Source Filename",
          "type": "string"
        },
        "pdf_page": {
          "description": "Physical PDF page where the information was found. This is lightweight provenance, not a request for citation-ready quotation.",
          "minimum": 1,
          "title": "Pdf Page",
          "type": "integer"
        },
        "period_label_ja": {
          "minLength": 1,
          "title": "Period Label Ja",
          "type": "string"
        },
        "period_label_en": {
          "minLength": 1,
          "title": "Period Label En",
          "type": "string"
        },
        "statement_type": {
          "$ref": "#/$defs/StatementType"
        },
        "source_section": {
          "minLength": 1,
          "title": "Source Section",
          "type": "string"
        },
        "summary_ja": {
          "description": "Concise faithful summary of the useful source information. Exact quotation boundaries and verbatim transcription are not required.",
          "minLength": 1,
          "title": "Summary Ja",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "source_filename",
        "pdf_page",
        "period_label_ja",
        "period_label_en",
        "statement_type",
        "source_section",
        "summary_ja"
      ],
      "title": "ResearchSourceRecord",
      "type": "object"
    },
    "RevisionDirection": {
      "enum": [
        "up",
        "down",
        "mixed",
        "none_observed",
        "not_assessable"
      ],
      "title": "RevisionDirection",
      "type": "string"
    },
    "StatementType": {
      "enum": [
        "actual",
        "forecast",
        "target",
        "risk",
        "inference",
        "mixed"
      ],
      "title": "StatementType",
      "type": "string"
    }
  },
  "description": "PDF-backed extraction output consumed by the synthesis request.",
  "properties": {
    "schema_version": {
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/CompanyIdentity"
    },
    "source_records": {
      "items": {
        "$ref": "#/$defs/ResearchSourceRecord"
      },
      "minItems": 1,
      "title": "Source Records",
      "type": "array"
    },
    "filing_coverage": {
      "items": {
        "$ref": "#/$defs/ResearchFilingCoverage"
      },

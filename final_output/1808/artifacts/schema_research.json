{
  "$defs": {
    "CompanyIdentity": {
      "additionalProperties": false,
      "properties": {
        "security_code": {
          "description": "Exact requested security code; do not infer a different issuer.",
          "minLength": 1,
          "title": "Security Code",
          "type": "string"
        },
        "company_name_ja": {
          "description": "Japanese company name stated in the latest supplied filing.",
          "minLength": 1,
          "title": "Company Name Ja",
          "type": "string"
        },
        "company_name_en": {
          "description": "English company name stated in the supplied filings, or a faithful romanization when no English name is shown.",
          "minLength": 1,
          "title": "Company Name En",
          "type": "string"
        },
        "latest_filename": {
          "description": "Exact authoritative filename of the filing identified as latest.",
          "minLength": 1,
          "title": "Latest Filename",
          "type": "string"
        },
        "latest_period_ja": {
          "description": "Concise Japanese reporting-period label for the latest filing.",
          "minLength": 1,
          "title": "Latest Period Ja",
          "type": "string"
        },
        "latest_period_en": {
          "description": "Concise English equivalent of latest_period_ja.",
          "minLength": 1,
          "title": "Latest Period En",
          "type": "string"
        }
      },
      "required": [
        "security_code",
        "company_name_ja",
        "company_name_en",
        "latest_filename",
        "latest_period_ja",
        "latest_period_en"
      ],
      "title": "CompanyIdentity",
      "type": "object"
    },
    "FilingPeriod": {
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "FY",
        "UNKNOWN"
      ],
      "title": "FilingPeriod",
      "type": "string"
    },
    "FinancialMetric": {
      "enum": [
        "revenue",
        "operating_profit",
        "ordinary_profit",
        "pretax_profit",
        "net_income",
        "operating_cash_flow",
        "investing_cash_flow",
        "free_cash_flow",
        "total_assets",
        "net_assets",
        "interest_bearing_debt",
        "dividend_per_share",
        "segment_revenue",
        "segment_profit",
        "other"
      ],
      "title": "FinancialMetric",
      "type": "string"
    },
    "FinancialScope": {
      "enum": [
        "consolidated",
        "company_only",
        "segment",
        "other"
      ],
      "title": "FinancialScope",
      "type": "string"
    },
    "FinancialValueKind": {
      "enum": [
        "monetary",
        "percentage",
        "per_share",
        "count",
        "ratio",
        "other"
      ],
      "title": "FinancialValueKind",
      "type": "string"
    },
    "ResearchFilingMemo": {
      "description": "Direct, high-recall summary of one selected filing.",
      "properties": {
        "source_filename": {
          "minLength": 1,
          "title": "Source Filename",
          "type": "string"
        },
        "fiscal_year": {
          "maximum": 2200,
          "minimum": 1900,
          "title": "Fiscal Year",
          "type": "integer"
        },
        "period": {
          "$ref": "#/$defs/FilingPeriod"
        },
        "period_label_ja": {
          "minLength": 1,
          "title": "Period Label Ja",
          "type": "string"
        },
        "is_latest": {
          "title": "Is Latest",
          "type": "boolean"
        },
        "pdf_page_count": {
          "description": "Physical PDF page count from the supplied document metadata.",
          "minimum": 1,
          "title": "Pdf Page Count",
          "type": "integer"
        },
        "items": {
          "description": "Decision-useful observations from this filing. Core management discussion is retained even when wording is repetitive.",
          "items": {
            "$ref": "#/$defs/ResearchMemoItem"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "annual_financial_anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchMemoFinancialAnchor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unavailable_categories": {
          "description": "Categories absent or unreadable in this PDF. Do not use this field merely because a section appears routine.",
          "items": {
            "enum": [
              "business_overview",
              "operating_results",
              "financial_condition",
              "forward_looking_information",
              "strategy_and_execution",
              "segments_and_business_drivers",
              "capital_allocation",
              "material_footnote"
            ],
            "type": "string"
          },
          "title": "Unavailable Categories",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "source_filename",
        "fiscal_year",
        "period",
        "period_label_ja",
        "is_latest",
        "pdf_page_count",
        "items"
      ],
      "title": "ResearchFilingMemo",
      "type": "object"
    },
    "ResearchMemoFinancialAnchor": {
      "description": "One comparable annual actual and the next original annual forecast.",
      "properties": {
        "metric": {
          "$ref": "#/$defs/FinancialMetric"
        },
        "metric_label_ja": {
          "minLength": 1,
          "title": "Metric Label Ja",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/FinancialScope"
        },
        "scope_label_ja": {
          "minLength": 1,
          "title": "Scope Label Ja",
          "type": "string"
        },
        "value_kind": {
          "$ref": "#/$defs/FinancialValueKind"
        },
        "actual": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchMemoFinancialPoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_original_forecast": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchMemoFinancialPoint"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "metric",
        "metric_label_ja",
        "scope",
        "scope_label_ja",
        "value_kind",
        "actual",
        "next_original_forecast"
      ],
      "title": "ResearchMemoFinancialAnchor",
      "type": "object"
    },
    "ResearchMemoFinancialPoint": {
      "description": "One actual or original-forecast value in a year-end filing.",
      "properties": {
        "target_fiscal_year": {
          "maximum": 2200,
          "minimum": 1900,
          "title": "Target Fiscal Year",
          "type": "integer"
        },
        "target_period": {
          "$ref": "#/$defs/FilingPeriod"
        },
        "value_surface_ja": {
          "minLength": 1,
          "title": "Value Surface Ja",
          "type": "string"
        },
        "pdf_page": {
          "minimum": 1,
          "title": "Pdf Page",
          "type": "integer"
        }
      },
      "required": [
        "target_fiscal_year",
        "target_period",
        "value_surface_ja",
        "pdf_page"
      ],
      "title": "ResearchMemoFinancialPoint",
      "type": "object"
    },
    "ResearchMemoItem": {
      "description": "One dense filing-specific observation used as an attention guide.",
      "properties": {
        "category": {
          "enum": [
            "business_overview",
            "operating_results",
            "financial_condition",
            "forward_looking_information",
            "strategy_and_execution",
            "segments_and_business_drivers",
            "capital_allocation",
            "material_footnote"
          ],
          "title": "Category",
          "type": "string"
        },
        "pdf_page": {
          "description": "Physical 1-indexed PDF page containing the observation.",
          "minimum": 1,
          "title": "Pdf Page",
          "type": "integer"
        },
        "statement_type": {
          "$ref": "#/$defs/StatementType"
        },
        "summary_ja": {
          "description": "Concise, faithful Japanese summary retaining the original figures, periods, qualifiers, causes, actions, and forecast status needed for later analysis. For capital allocation, retain disclosed return measures, capital-cost or hurdle references, and later economic outcomes of material investments when available. Exact quotation is not required.",
          "minLength": 1,
          "title": "Summary Ja",
          "type": "string"
        }
      },
      "required": [
        "category",
        "pdf_page",
        "statement_type",
        "summary_ja"
      ],
      "title": "ResearchMemoItem",
      "type": "object"
    },
    "StatementType": {
      "enum": [
        "actual",
        "forecast",
        "target",
        "risk",
        "inference",
        "mixed"
      ],
      "title": "StatementType",
      "type": "string"
    }
  },
  "description": "Compact chronological research map consumed by synthesis.",
  "properties": {
    "schema_version": {
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/CompanyIdentity"
    },
    "filings": {
      "description": "Exactly one chronological research memo for every selected PDF.",
      "items": {
        "$ref": "#/$defs/ResearchFilingMemo"
      },
      "minItems": 1,
      "title": "Filings",
      "type": "array"
    },
    "research_notes": {
      "items": {
        "type": "string"
      },
      "title": "Research Notes",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "identity",
    "filings"
  ],
  "title": "JapaneseResearchDossier",
  "type": "object"
}

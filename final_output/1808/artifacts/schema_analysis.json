{
  "$defs": {
    "ManagementConsistencyDimension": {
      "enum": [
        "strategic_coherence",
        "execution_follow_through",
        "forecast_target_discipline",
        "accountability_transparency"
      ],
      "title": "ManagementConsistencyDimension",
      "type": "string"
    },
    "SectionKey": {
      "enum": [
        "latest.key_takeaway",
        "latest.business_driver",
        "latest.outlook",
        "latest.risk",
        "latest.context",
        "trend.perspective",
        "trend.consistent",
        "trend.change",
        "trend.capital_allocation",
        "trend.implication",
        "company.overview",
        "management.strategy",
        "management.execution",
        "management.forecast_discipline",
        "management.accountability"
      ],
      "title": "SectionKey",
      "type": "string"
    },
    "StatementType": {
      "enum": [
        "actual",
        "forecast",
        "target",
        "risk",
        "inference",
        "mixed"
      ],
      "title": "StatementType",
      "type": "string"
    },
    "SynthesisAnalysisClaim": {
      "description": "Analytical claim linked to lightweight extraction records.",
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "section": {
          "$ref": "#/$defs/SectionKey"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "headline_ja": {
          "description": "Concise analytical conclusion in Japanese.",
          "minLength": 1,
          "title": "Headline Ja",
          "type": "string"
        },
        "body_ja": {
          "description": "Investor-oriented Japanese analysis that explains the conclusion, period contrast, significance, and material uncertainty without duplicating other claims.",
          "minLength": 1,
          "title": "Body Ja",
          "type": "string"
        },
        "source_record_ids": {
          "description": "IDs of extracted source records used for this conclusion. These links are internal provenance and are not rendered as citations.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Record Ids",
          "type": "array"
        },
        "statement_type": {
          "$ref": "#/$defs/StatementType"
        },
        "is_inference": {
          "default": false,
          "title": "Is Inference",
          "type": "boolean"
        },
        "causal": {
          "default": false,
          "title": "Causal",
          "type": "boolean"
        }
      },
      "required": [
        "claim_id",
        "section",
        "order",
        "headline_ja",
        "body_ja",
        "source_record_ids",
        "statement_type"
      ],
      "title": "SynthesisAnalysisClaim",
      "type": "object"
    },
    "SynthesisManagementConsistency": {
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/SynthesisManagementConsistencyComponent"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Components",
          "type": "array"
        },
        "overall_rationale_ja": {
          "minLength": 1,
          "title": "Overall Rationale Ja",
          "type": "string"
        }
      },
      "required": [
        "components",
        "overall_rationale_ja"
      ],
      "title": "SynthesisManagementConsistency",
      "type": "object"
    },
    "SynthesisManagementConsistencyComponent": {
      "description": "One synthesis-stage management-consistency assessment.",
      "properties": {
        "dimension": {
          "$ref": "#/$defs/ManagementConsistencyDimension"
        },
        "rating": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rating"
        },
        "evidence_sufficiency": {
          "enum": [
            "sufficient",
            "insufficient"
          ],
          "title": "Evidence Sufficiency",
          "type": "string"
        },
        "rationale_ja": {
          "minLength": 1,
          "title": "Rationale Ja",
          "type": "string"
        },
        "source_record_ids": {
          "description": "Extraction records supporting the rating, including contrary information where available.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Record Ids",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "rating",
        "evidence_sufficiency",
        "rationale_ja",
        "source_record_ids"
      ],
      "title": "SynthesisManagementConsistencyComponent",
      "type": "object"
    }
  },
  "description": "Dossier-backed analytical prose returned by the second Japanese request.",
  "properties": {
    "schema_version": {
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/SynthesisAnalysisClaim"
      },
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "management_consistency": {
      "$ref": "#/$defs/SynthesisManagementConsistency"
    },
    "model_notes": {
      "items": {
        "type": "string"
      },
      "title": "Model Notes",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "claims",
    "management_consistency"
  ],
  "title": "JapaneseSynthesisResponse",
  "type": "object"
}

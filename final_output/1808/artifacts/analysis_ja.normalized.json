    {
      "claim_id": "claim_10",
      "section": "latest.risk",
      "order": 1,
      "headline_ja": "建設資材・労務費の高騰および人手不足に伴う施工コスト上昇と利益率悪化リスク",
      "body_ja": "建設業界全体での資材価格の上昇、技能労働者や後継者の不足、働き方改革に伴う時間外労働の上限規制の適用は、請負工事の原価上昇圧力を高める。同社は適正価格での受注とBIM等による生産性向上で対応しているが、原価高騰が想定を超えた場合、主力の建設関連事業の利益率が圧迫される不確実性がある。",
      "evidence_ids": [],
      "statement_type": "risk",
      "is_inference": true,
      "causal": true,
      "figures": [],
      "dates": [],
      "qualifiers": []
    },

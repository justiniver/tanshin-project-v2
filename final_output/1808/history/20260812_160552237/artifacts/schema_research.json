{
  "$defs": {
    "CommentaryIntensity": {
      "enum": [
        "low",
        "moderate",
        "high",
        "not_assessable"
      ],
      "title": "CommentaryIntensity",
      "type": "string"
    },
    "CommentaryTone": {
      "enum": [
        "positive",
        "negative",
        "mixed",
        "neutral",
        "uncertain"
      ],
      "title": "CommentaryTone",
      "type": "string"
    },
    "CommitmentOutcome": {
      "enum": [
        "achieved",
        "exceeded",
        "partly_achieved",
        "missed",
        "delayed",
        "revised",
        "withdrawn",
        "pending",
        "not_observable"
      ],
      "title": "CommitmentOutcome",
      "type": "string"
    },
    "CommitmentType": {
      "enum": [
        "annual_forecast",
        "medium_term_target",
        "strategic_commitment",
        "capital_allocation"
      ],
      "title": "CommitmentType",
      "type": "string"
    },
    "CompanyIdentity": {
      "additionalProperties": false,
      "properties": {
        "security_code": {
          "description": "Exact requested security code; do not infer a different issuer.",
          "minLength": 1,
          "title": "Security Code",
          "type": "string"
        },
        "company_name_ja": {
          "description": "Japanese company name stated in the latest supplied filing.",
          "minLength": 1,
          "title": "Company Name Ja",
          "type": "string"
        },
        "company_name_en": {
          "description": "English company name stated in the supplied filings, or a faithful romanization when no English name is shown.",
          "minLength": 1,
          "title": "Company Name En",
          "type": "string"
        },
        "latest_filename": {
          "description": "Exact authoritative filename of the filing identified as latest.",
          "minLength": 1,
          "title": "Latest Filename",
          "type": "string"
        },
        "latest_period_ja": {
          "description": "Concise Japanese reporting-period label for the latest filing.",
          "minLength": 1,
          "title": "Latest Period Ja",
          "type": "string"
        },
        "latest_period_en": {
          "description": "Concise English equivalent of latest_period_ja.",
          "minLength": 1,
          "title": "Latest Period En",
          "type": "string"
        }
      },
      "required": [
        "security_code",
        "company_name_ja",
        "company_name_en",
        "latest_filename",
        "latest_period_ja",
        "latest_period_en"
      ],
      "title": "CompanyIdentity",
      "type": "object"
    },
    "DisclosureCategory": {
      "enum": [
        "impairment",
        "unusual_gain_or_loss",
        "litigation_or_regulatory",
        "accounting_or_estimate_change",
        "going_concern",
        "related_party",
        "capital_allocation",
        "risk",
        "other"
      ],
      "title": "DisclosureCategory",
      "type": "string"
    },
    "DriverDirection": {
      "enum": [
        "positive",
        "negative",
        "mixed",
        "uncertain"
      ],
      "title": "DriverDirection",
      "type": "string"
    },
    "DriverNature": {
      "enum": [
        "structural",
        "cyclical",
        "company_specific",
        "mixed"
      ],
      "title": "DriverNature",
      "type": "string"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "description": "Unique stable ID formatted as <source_filename>:sNNNN, using a four-digit sequence within the response.",
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "source_filename": {
          "description": "Exact source_filename from the metadata preceding the cited PDF.",
          "minLength": 1,
          "title": "Source Filename",
          "type": "string"
        },
        "pdf_page": {
          "description": "Physical 1-indexed PDF page containing the quote; never a printed footer, contents-page, or document page label.",
          "minimum": 1,
          "title": "Pdf Page",
          "type": "integer"
        },
        "exact_quote_ja": {
          "description": "Verbatim contiguous Japanese sentence or short passage that contains the material facts, figures, dates, qualifiers, and causal wording used.",
          "minLength": 1,
          "title": "Exact Quote Ja",
          "type": "string"
        },
        "period_label_ja": {
          "description": "Concise Japanese period label suitable for a citation.",
          "minLength": 1,
          "title": "Period Label Ja",
          "type": "string"
        },
        "period_label_en": {
          "description": "Concise English equivalent of period_label_ja.",
          "minLength": 1,
          "title": "Period Label En",
          "type": "string"
        },
        "statement_type": {
          "$ref": "#/$defs/StatementType",
          "description": "Nature of the quoted source statement, not the analyst's tone."
        },
        "source_section": {
          "description": "Concise filing section or table name where the quote appears.",
          "minLength": 1,
          "title": "Source Section",
          "type": "string"
        },
        "tags": {
          "description": "Optional short topical labels; use an empty list when unnecessary.",
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "source_filename",
        "pdf_page",
        "exact_quote_ja",
        "period_label_ja",
        "period_label_en",
        "statement_type",
        "source_section"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "FilingCoverageStatus": {
      "enum": [
        "complete",
        "partial",
        "no_material_disclosure"
      ],
      "title": "FilingCoverageStatus",
      "type": "string"
    },
    "FilingPeriod": {
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "FY",
        "UNKNOWN"
      ],
      "title": "FilingPeriod",
      "type": "string"
    },
    "FinancialMetric": {
      "enum": [
        "revenue",
        "operating_profit",
        "ordinary_profit",
        "pretax_profit",
        "net_income",
        "operating_cash_flow",
        "investing_cash_flow",
        "free_cash_flow",
        "total_assets",
        "net_assets",
        "interest_bearing_debt",
        "dividend_per_share",
        "segment_revenue",
        "segment_profit",
        "other"
      ],
      "title": "FinancialMetric",
      "type": "string"
    },
    "FinancialScope": {
      "enum": [
        "consolidated",
        "company_only",
        "segment",
        "other"
      ],
      "title": "FinancialScope",
      "type": "string"
    },
    "FinancialValueKind": {
      "enum": [
        "monetary",
        "percentage",
        "per_share",
        "count",
        "ratio",
        "other"
      ],
      "title": "FinancialValueKind",
      "type": "string"
    },
    "ForecastPosture": {
      "enum": [
        "conservative",
        "balanced",
        "aggressive",
        "mixed",
        "not_assessable"
      ],
      "title": "ForecastPosture",
      "type": "string"
    },
    "ForecastVersion": {
      "enum": [
        "original",
        "revised",
        "latest",
        "not_applicable"
      ],
      "title": "ForecastVersion",
      "type": "string"
    },
    "ManagementConsistencyDimension": {
      "enum": [
        "strategic_coherence",
        "execution_follow_through",
        "forecast_target_discipline",
        "accountability_transparency"
      ],
      "title": "ManagementConsistencyDimension",
      "type": "string"
    },
    "ModelManagementConsistency": {
      "description": "Model inputs only; Python calculates the published score.",
      "properties": {
        "components": {
          "description": "Exactly one component for each of the four required consistency dimensions.",
          "items": {
            "$ref": "#/$defs/ModelManagementConsistencyComponent"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Components",
          "type": "array"
        },
        "overall_rationale_ja": {
          "description": "Concise synthesis of the company's management consistency across the selected trend period, including the strongest evidence for and against consistency and any important qualifications.",
          "minLength": 1,
          "title": "Overall Rationale Ja",
          "type": "string"
        }
      },
      "required": [
        "components",
        "overall_rationale_ja"
      ],
      "title": "ModelManagementConsistency",
      "type": "object"
    },
    "ModelManagementConsistencyComponent": {
      "description": "One model-rated input to the locally calculated consistency score.",
      "properties": {
        "dimension": {
          "$ref": "#/$defs/ManagementConsistencyDimension",
          "description": "Exact consistency dimension being assessed."
        },
        "rating": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Evidence-based ordinal rating: 0 materially inconsistent, 1 weak, 2 mixed, 3 generally consistent, or 4 highly consistent. Assign a best evidence-based rating whenever the selected longitudinal filings permit a defensible assessment. Use null only in the exceptional case where no defensible assessment can be made.",
          "title": "Rating"
        },
        "evidence_sufficiency": {
          "description": "Whether the selected filings provide enough longitudinal evidence to assign this component a substantive rating.",
          "enum": [
            "sufficient",
            "insufficient"
          ],
          "title": "Evidence Sufficiency",
          "type": "string"
        },
        "rationale_ja": {
          "description": "Concise Japanese explanation comparing what management said with later actions, outcomes, revisions, or explanations. State both the strongest supporting evidence and any material counterevidence, and compare targets with results using the same scope and time horizon.",
          "minLength": 1,
          "title": "Rationale Ja",
          "type": "string"
        },
        "evidence_ids": {
          "description": "Evidence IDs from management-discussion passages that support the rating or explain why the evidence is insufficient.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "rating",
        "evidence_sufficiency",
        "rationale_ja",
        "evidence_ids"
      ],
      "title": "ModelManagementConsistencyComponent",
      "type": "object"
    },
    "ResearchBusinessDriver": {
      "description": "One comparable business driver extracted from the selected filings.",
      "properties": {
        "driver_id": {
          "minLength": 1,
          "title": "Driver Id",
          "type": "string"
        },
        "canonical_tag": {
          "description": "Short reusable driver category such as customer_demand, pricing, material_costs, labor_costs, interest_rates, foreign_exchange, utilization, regulation, technology_investment, or other.",
          "minLength": 1,
          "title": "Canonical Tag",
          "type": "string"
        },
        "label_ja": {
          "description": "Concise Japanese reader-facing driver label.",
          "minLength": 1,
          "title": "Label Ja",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/DriverDirection"
        },
        "importance": {
          "enum": [
            "primary",
            "secondary"
          ],
          "title": "Importance",
          "type": "string"
        },
        "nature": {
          "$ref": "#/$defs/DriverNature"
        },
        "affected_area_ja": {
          "description": "Business, segment, margin, cash-flow, or balance-sheet area affected.",
          "minLength": 1,
          "title": "Affected Area Ja",
          "type": "string"
        },
        "summary_ja": {
          "description": "Concise explanation of the operating or financial transmission mechanism, including material qualifications.",
          "minLength": 1,
          "title": "Summary Ja",
          "type": "string"
        },
        "observed_periods_ja": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Observed Periods Ja",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "driver_id",
        "canonical_tag",
        "label_ja",
        "direction",
        "importance",
        "nature",
        "affected_area_ja",
        "summary_ja",
        "observed_periods_ja",
        "evidence_ids"
      ],
      "title": "ResearchBusinessDriver",
      "type": "object"
    },
    "ResearchCommentaryObservation": {
      "description": "One filing-specific management-commentary observation.",
      "properties": {
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "source_filename": {
          "minLength": 1,
          "title": "Source Filename",
          "type": "string"
        },
        "fiscal_year": {
          "maximum": 2200,
          "minimum": 1900,
          "title": "Fiscal Year",
          "type": "integer"
        },
        "period_label_ja": {
          "minLength": 1,
          "title": "Period Label Ja",
          "type": "string"
        },
        "canonical_tag": {
          "description": "Stable reusable category such as demand, volume, pricing, material_costs, labor_costs, foreign_exchange, interest_rates, capital_allocation, overseas_execution, or other.",
          "minLength": 1,
          "title": "Canonical Tag",
          "type": "string"
        },
        "label_ja": {
          "minLength": 1,
          "title": "Label Ja",
          "type": "string"
        },
        "tone": {
          "$ref": "#/$defs/CommentaryTone"
        },
        "intensity": {
          "$ref": "#/$defs/CommentaryIntensity"
        },
        "summary_ja": {
          "minLength": 1,
          "title": "Summary Ja",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "source_filename",
        "fiscal_year",
        "period_label_ja",
        "canonical_tag",
        "label_ja",
        "tone",
        "intensity",
        "summary_ja",
        "evidence_ids"
      ],
      "title": "ResearchCommentaryObservation",
      "type": "object"
    },
    "ResearchCommitmentRecord": {
      "description": "A forecast, target, or commitment connected to a later observable outcome.",
      "properties": {
        "commitment_id": {
          "minLength": 1,
          "title": "Commitment Id",
          "type": "string"
        },
        "commitment_type": {
          "$ref": "#/$defs/CommitmentType"
        },
        "statement_period_ja": {
          "minLength": 1,
          "title": "Statement Period Ja",
          "type": "string"
        },
        "commitment_ja": {
          "minLength": 1,
          "title": "Commitment Ja",
          "type": "string"
        },
        "due_period_ja": {
          "minLength": 1,
          "title": "Due Period Ja",
          "type": "string"
        },
        "outcome_status": {
          "$ref": "#/$defs/CommitmentOutcome"
        },
        "outcome_ja": {
          "description": "Later result or a concise statement that the outcome is not yet observable in the selected filings.",
          "minLength": 1,
          "title": "Outcome Ja",
          "type": "string"
        },
        "revision_direction": {
          "$ref": "#/$defs/RevisionDirection"
        },
        "forecast_posture": {
          "$ref": "#/$defs/ForecastPosture"
        },
        "evidence_ids": {
          "description": "Evidence for the original statement and, when observable, its revision or later outcome.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "commitment_id",
        "commitment_type",
        "statement_period_ja",
        "commitment_ja",
        "due_period_ja",
        "outcome_status",
        "outcome_ja",
        "revision_direction",
        "forecast_posture",
        "evidence_ids"
      ],
      "title": "ResearchCommitmentRecord",
      "type": "object"
    },
    "ResearchDisclosureRecord": {
      "description": "Material footnote or mandatory-disclosure signal.",
      "properties": {
        "disclosure_id": {
          "minLength": 1,
          "title": "Disclosure Id",
          "type": "string"
        },
        "source_filename": {
          "minLength": 1,
          "title": "Source Filename",
          "type": "string"
        },
        "fiscal_year": {
          "maximum": 2200,
          "minimum": 1900,
          "title": "Fiscal Year",
          "type": "integer"
        },
        "category": {
          "$ref": "#/$defs/DisclosureCategory"
        },
        "label_ja": {
          "minLength": 1,
          "title": "Label Ja",
          "type": "string"
        },
        "summary_ja": {
          "minLength": 1,
          "title": "Summary Ja",
          "type": "string"
        },
        "importance": {
          "enum": [
            "primary",
            "secondary"
          ],
          "title": "Importance",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "disclosure_id",
        "source_filename",
        "fiscal_year",
        "category",
        "label_ja",
        "summary_ja",
        "importance",
        "evidence_ids"
      ],
      "title": "ResearchDisclosureRecord",
      "type": "object"
    },
    "ResearchFilingCoverage": {
      "description": "Coverage ledger proving that every selected filing was inspected.",
      "properties": {
        "source_filename": {
          "description": "Exact filename of one selected filing.",
          "minLength": 1,
          "title": "Source Filename",
          "type": "string"
        },
        "fiscal_year": {
          "maximum": 2200,
          "minimum": 1900,
          "title": "Fiscal Year",
          "type": "integer"
        },
        "period": {
          "$ref": "#/$defs/FilingPeriod"
        },
        "period_label_ja": {
          "minLength": 1,
          "title": "Period Label Ja",
          "type": "string"
        },
        "is_latest": {
          "title": "Is Latest",
          "type": "boolean"
        },
        "coverage_status": {
          "$ref": "#/$defs/FilingCoverageStatus"
        },
        "management_discussion_evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "title": "Management Discussion Evidence Ids",
          "type": "array"
        },
        "outlook_evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "title": "Outlook Evidence Ids",
          "type": "array"
        },
        "segment_evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "title": "Segment Evidence Ids",
          "type": "array"
        },
        "cash_flow_evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1,
          "title": "Cash Flow Evidence Ids",
          "type": "array"
        },
        "capital_allocation_evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1,
          "title": "Capital Allocation Evidence Ids",
          "type": "array"
        },
        "footnote_evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1,
          "title": "Footnote Evidence Ids",
          "type": "array"
        },
        "financial_observation_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Financial Observation Ids",
          "type": "array"
        },
        "commentary_observation_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "title": "Commentary Observation Ids",
          "type": "array"
        },
        "disclosure_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "title": "Disclosure Ids",
          "type": "array"
        },
        "coverage_gaps": {
          "description": "Concise missing or unavailable categories. Use an empty list when coverage is complete; never silently omit an unavailable category.",
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Coverage Gaps",
          "type": "array"
        }
      },
      "required": [
        "source_filename",
        "fiscal_year",
        "period",
        "period_label_ja",
        "is_latest",
        "coverage_status",
        "management_discussion_evidence_ids",
        "outlook_evidence_ids",
        "segment_evidence_ids",
        "cash_flow_evidence_ids",
        "capital_allocation_evidence_ids",
        "footnote_evidence_ids",
        "financial_observation_ids",
        "commentary_observation_ids",
        "disclosure_ids",
        "coverage_gaps"
      ],
      "title": "ResearchFilingCoverage",
      "type": "object"
    },
    "ResearchFinancialObservation": {
      "description": "One exact financial value used for local comparisons.",
      "properties": {
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "source_filename": {
          "minLength": 1,
          "title": "Source Filename",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/FinancialMetric"
        },
        "metric_label_ja": {
          "minLength": 1,
          "title": "Metric Label Ja",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/FinancialScope"
        },
        "scope_label_ja": {
          "minLength": 1,
          "title": "Scope Label Ja",
          "type": "string"
        },
        "value_kind": {
          "$ref": "#/$defs/FinancialValueKind"
        },
        "statement_type": {
          "enum": [
            "actual",
            "forecast",
            "target"
          ],
          "title": "Statement Type",
          "type": "string"
        },
        "forecast_version": {
          "$ref": "#/$defs/ForecastVersion"
        },
        "target_fiscal_year": {
          "maximum": 2200,
          "minimum": 1900,
          "title": "Target Fiscal Year",
          "type": "integer"
        },
        "target_period": {
          "$ref": "#/$defs/FilingPeriod"
        },
        "value_surface_ja": {
          "description": "Exact monetary, percentage, per-share, count, or ratio substring as written in the cited evidence.",
          "minLength": 1,
          "title": "Value Surface Ja",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "source_filename",
        "metric",
        "metric_label_ja",
        "scope",
        "scope_label_ja",
        "value_kind",
        "statement_type",
        "forecast_version",
        "target_fiscal_year",
        "target_period",
        "value_surface_ja",
        "evidence_id"
      ],
      "title": "ResearchFinancialObservation",
      "type": "object"
    },
    "ResearchThemeRecord": {
      "description": "A recurring or changing management-commentary theme.",
      "properties": {
        "theme_id": {
          "minLength": 1,
          "title": "Theme Id",
          "type": "string"
        },
        "label_ja": {
          "minLength": 1,
          "title": "Label Ja",
          "type": "string"
        },
        "development": {
          "$ref": "#/$defs/ThemeDevelopment"
        },
        "early_period_ja": {
          "minLength": 1,
          "title": "Early Period Ja",
          "type": "string"

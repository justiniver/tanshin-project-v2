{
  "$defs": {
    "ManagementConsistencyDimension": {
      "enum": [
        "strategic_coherence",
        "execution_follow_through",
        "forecast_target_discipline",
        "accountability_transparency"
      ],
      "title": "ManagementConsistencyDimension",
      "type": "string"
    },
    "SectionKey": {
      "enum": [
        "latest.key_takeaway",
        "latest.business_driver",
        "latest.outlook",
        "latest.risk",
        "latest.context",
        "trend.perspective",
        "trend.consistent",
        "trend.change",
        "trend.capital_allocation",
        "trend.capital_value_creation",
        "trend.implication",
        "company.overview",
        "management.strategy",
        "management.execution",
        "management.forecast_discipline",
        "management.accountability"
      ],
      "title": "SectionKey",
      "type": "string"
    },
    "StatementType": {
      "enum": [
        "actual",
        "forecast",
        "target",
        "risk",
        "inference",
        "mixed"
      ],
      "title": "StatementType",
      "type": "string"
    },
    "SynthesisAnalysisClaim": {
      "description": "One citation-free analytical claim from the PDF-backed synthesis pass.",
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "section": {
          "$ref": "#/$defs/SectionKey"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "headline_ja": {
          "description": "Concise analytical conclusion in Japanese.",
          "minLength": 1,
          "title": "Headline Ja",
          "type": "string"
        },
        "body_ja": {
          "description": "Independent investor-oriented Japanese analysis that explains the conclusion, period contrast, significance, and material uncertainty without duplicating other claims. Distinguish management's assertions from observable outcomes and do not adopt promotional management language as the analyst's conclusion.",
          "minLength": 1,
          "title": "Body Ja",
          "type": "string"
        },
        "statement_type": {
          "$ref": "#/$defs/StatementType"
        },
        "is_inference": {
          "default": false,
          "title": "Is Inference",
          "type": "boolean"
        },
        "causal": {
          "default": false,
          "title": "Causal",
          "type": "boolean"
        }
      },
      "required": [
        "claim_id",
        "section",
        "order",
        "headline_ja",
        "body_ja",
        "statement_type"
      ],
      "title": "SynthesisAnalysisClaim",
      "type": "object"
    },
    "SynthesisManagementConsistency": {
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/SynthesisManagementConsistencyComponent"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "components"
      ],
      "title": "SynthesisManagementConsistency",
      "type": "object"
    },
    "SynthesisManagementConsistencyComponent": {
      "description": "Rating metadata; the corresponding management claim contains the rationale.",
      "properties": {
        "dimension": {
          "$ref": "#/$defs/ManagementConsistencyDimension"
        },
        "rating": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rating"
        },
        "evidence_sufficiency": {
          "enum": [
            "sufficient",
            "insufficient"
          ],
          "title": "Evidence Sufficiency",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "rating",
        "evidence_sufficiency"
      ],
      "title": "SynthesisManagementConsistencyComponent",
      "type": "object"
    }
  },
  "description": "PDF-backed analytical prose guided by the chronological research map.",
  "properties": {
    "schema_version": {
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/SynthesisAnalysisClaim"
      },
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "management_consistency": {
      "$ref": "#/$defs/SynthesisManagementConsistency"
    },
    "model_notes": {
      "items": {
        "type": "string"
      },
      "title": "Model Notes",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "claims",
    "management_consistency"
  ],
  "title": "JapaneseSynthesisResponse",
  "type": "object"
}

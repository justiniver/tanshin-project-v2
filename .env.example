# Copy this file to .env and replace the placeholder locally.
# Never commit, print, or paste the real key into logs or issue reports.
GEMINI_API_KEY=replace-with-your-api-key

# Optional. Leave unset to use the repository default analysis model.
# If set, it must match the model in tanshin_pipeline/config.py.
# GEMINI_MODEL=gemini-3.6-flash

# Optional secondary Gemini key. Used by --flash-translation with the fixed
# Flash model, and by --pro-translation, --pro, and --sol with GEMINI_MODEL2.
GEMINI_API_KEY2=replace-with-your-api-key
GEMINI_MODEL2=gemini-3.1-pro-preview

# Optional hybrid Sol profile. GPT-5.6 Sol uses this key for Japanese analysis;
# English translation continues to use the secondary Gemini Pro profile above.
OPENAI_API_KEY=replace-with-your-api-key
